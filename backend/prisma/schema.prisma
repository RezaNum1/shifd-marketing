generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                       String                   @id @default(uuid()) @db.Uuid
  name                     String
  description              String
  industry                 String?
  businessTypes            String[]                 @default([]) @map("business_types")
  primaryMarket            String?                  @map("primary_market")
  website                  String?
  mission                  String?
  vision                   String?
  positioning              String?
  coreValueProposition     String?                  @map("core_value_proposition")
  differentiators          String[]                 @default([])
  customerSegments         String[]                 @default([]) @map("customer_segments")
  decisionMakers           String[]                 @default([]) @map("decision_makers")
  painPoints               String[]                 @default([]) @map("pain_points")
  reportingTimezone        String                   @default("Asia/Jakarta") @map("reporting_timezone")
  contextVersion           Int                      @default(1) @map("context_version")
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                  Int                      @default(1)
  users                    User[]
  brandProfile             BrandProfile?
  bmcBlocks                BmcBlock[]
  products                 Product[]
  contentIdeas             ContentIdea[]
  contents                 Content[]
  canvaDesignLinks         ContentCanvaDesignLink[]
  idempotencyRecords       RequestIdempotency[]
  assets                   CreativeAsset[]
  aiSettings               AiSettings?
  aiRequests               AiRequestLog[]
  socialAccounts           SocialAccount[]
  creativeReferenceBatches CreativeReferenceBatch[]
  topicDiscoveryRuns       TopicDiscoveryRun[]
  topicCandidates          TopicCandidate[]
  telegramIntegrations     TelegramIntegration[]
  telegramLinkTokens       TelegramLinkToken[]
  telegramThreads          TelegramIdeationThread[]
  telegramIdeaDrafts       TelegramIdeaDraft[]
  telegramUpdates          TelegramWebhookUpdate[]
  prospects                Prospect[]
  prospectImportBatches    ProspectImportBatch[]
  prospectResearchRuns     ProspectResearchRun[]
  prospectEmailDrafts      ProspectEmailDraft[]
  outboundActivities       OutboundActivity[]
  marketingEvaluations    MarketingEvaluation[]
  businessInquiries       BusinessInquiry[]
  productionTimeLogs      ProductionTimeLog[]

  @@map("companies")
}

model User {
  id                    String                   @id @default(uuid()) @db.Uuid
  companyId             String                   @map("company_id") @db.Uuid
  name                  String
  email                 String
  passwordHash          String                   @map("password_hash")
  role                  String                   @default("founder")
  active                Boolean                  @default(true)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  version               Int                      @default(1)
  company               Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sessions              AuthSession[]
  contentIdeas          ContentIdea[]
  contents              Content[]
  contentEvents         ContentEvent[]
  uploadedAssets        CreativeAsset[]
  aiRequests            AiRequestLog[]
  approvalActions       ApprovalAction[]
  createdSchedules      ContentSchedule[]        @relation("ScheduleCreatedBy")
  markedPublications    PublicationRecord[]      @relation("PublicationMarkedBy")
  recordedMetrics       WeeklyMetric[]           @relation("MetricRecordedBy")
  recordedInquiries     InboundInquiryMetric[]   @relation("InquiryRecordedBy")
  telegramIntegrations  TelegramIntegration[]
  telegramLinkTokens    TelegramLinkToken[]
  telegramThreads       TelegramIdeationThread[]
  telegramIdeaDrafts    TelegramIdeaDraft[]
  createdProspects      Prospect[]
  createdResearchRuns   ProspectResearchRun[]
  reviewedResearchClaims ProspectResearchClaim[] @relation("ResearchClaimReviewer")
  prospectImportBatches ProspectImportBatch[]
  createdProspectEmailDrafts ProspectEmailDraft[] @relation("ProspectEmailDraftCreator")
  createdOutboundActivities OutboundActivity[]    @relation("OutboundActivityCreator")
  updatedOutboundActivities OutboundActivity[]   @relation("OutboundActivityUpdater")
  archivedOutboundActivities OutboundActivity[]   @relation("OutboundActivityArchiver")
  createdMarketingEvaluations MarketingEvaluation[] @relation("EvaluationCreator")
  recordedEvaluationSnapshots EvaluationSnapshot[] @relation("EvaluationSnapshotRecorder")
  recordedBusinessInquiries BusinessInquiry[] @relation("InquiryRecorder")
  recordedProductionTimeLogs ProductionTimeLog[] @relation("ProductionTimeRecorder")
  createdCanvaDesignLinks   ContentCanvaDesignLink[] @relation("CanvaDesignLinkCreator")
  updatedCanvaDesignLinks   ContentCanvaDesignLink[] @relation("CanvaDesignLinkUpdater")
  createdReviewShares       ContentReviewShare[]

  @@unique([companyId, id])
  @@index([companyId])
  @@map("users")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  csrfSecretHash    String    @map("csrf_secret_hash")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model Prospect {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  name              String
  normalizedName    String               @map("normalized_name")
  normalizedDomain  String?              @map("normalized_domain")
  importFingerprint String?              @map("import_fingerprint")
  importBatchId     String?              @map("import_batch_id") @db.Uuid
  industry          String?
  website           String?
  address           String?
  employeeCount     Int?                 @map("employee_count")
  employeeSize      String?              @map("employee_size")
  contactName       String?              @map("contact_name")
  contactEmail      String?              @map("contact_email")
  contactPhone      String?              @map("contact_phone")
  notes             String?
  status            String               @default("lead")
  source            String               @default("manual")
  archivedAt        DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdBy         String               @map("created_by") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int                  @default(1)
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator           User                 @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  importBatch       ProspectImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  researchRuns      ProspectResearchRun[]
  emailDrafts       ProspectEmailDraft[]
  outboundActivities OutboundActivity[]
  businessInquiries BusinessInquiry[]

  @@unique([companyId, id])
  @@index([companyId, archivedAt, updatedAt, id])
  @@index([companyId, industry, status])
  @@index([companyId, createdBy])
  @@index([companyId, normalizedName])
  @@index([companyId, importFingerprint])
  @@index([importBatchId])
  @@map("prospects")
}

model ProspectImportBatch {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  createdBy   String     @map("created_by") @db.Uuid
  tokenHash   String     @unique @map("token_hash")
  fileDigest  String     @map("file_digest")
  preview     Json
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  confirmedAt DateTime?  @map("confirmed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator     User       @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  prospects   Prospect[]

  @@index([companyId, expiresAt])
  @@index([createdBy, expiresAt])
  @@map("prospect_import_batches")
}

model ProspectResearchRun {
  id                    String                  @id @default(uuid()) @db.Uuid
  companyId             String                  @map("company_id") @db.Uuid
  prospectId            String                  @map("prospect_id") @db.Uuid
  createdBy             String                  @map("created_by") @db.Uuid
  aiRequestLogId        String                  @unique @map("ai_request_log_id") @db.Uuid
  promptVersionId       String                  @map("prompt_version_id") @db.Uuid
  status                String
  identityStatus        String                  @map("identity_status")
  identityExplanation   String                  @map("identity_explanation")
  summary               String
  limitations           String[]                @default([])
  researchedAt          DateTime                @map("researched_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  prospect              Prospect                @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  creator               User                    @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  aiRequestLog          AiRequestLog            @relation(fields: [aiRequestLogId], references: [id], onDelete: Restrict)
  promptVersion         PromptVersion           @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  sources               ProspectResearchSource[]
  claims                ProspectResearchClaim[]

  @@unique([companyId, id])
  @@index([companyId, prospectId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@map("prospect_research_runs")
}

model ProspectResearchSource {
  id            String                  @id @default(uuid()) @db.Uuid
  runId         String                  @map("run_id") @db.Uuid
  url           String
  title         String
  publisher     String?
  domain        String
  retrievedAt   DateTime                @map("retrieved_at") @db.Timestamptz(3)
  sourceType    String                  @map("source_type")
  availability  String                  @default("retrieved")
  run           ProspectResearchRun     @relation(fields: [runId], references: [id], onDelete: Restrict)
  claimLinks    ProspectResearchClaimSource[]

  @@unique([runId, url])
  @@index([runId])
  @@map("prospect_research_sources")
}

model ProspectResearchClaim {
  id          String                      @id @default(uuid()) @db.Uuid
  runId       String                      @map("run_id") @db.Uuid
  text        String
  category    String
  claimType   String                      @map("claim_type")
  reviewStatus String                     @default("pending") @map("review_status")
  reviewNote  String?                     @map("review_note")
  reviewedAt  DateTime?                   @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy  String?                     @map("reviewed_by") @db.Uuid
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  run         ProspectResearchRun         @relation(fields: [runId], references: [id], onDelete: Restrict)
  reviewer    User?                       @relation("ResearchClaimReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  sources     ProspectResearchClaimSource[]
  emailDrafts ProspectEmailDraftClaim[]

  @@index([runId, claimType, reviewStatus])
  @@map("prospect_research_claims")
}

model ProspectResearchClaimSource {
  claimId  String                 @map("claim_id") @db.Uuid
  sourceId String                 @map("source_id") @db.Uuid
  claim    ProspectResearchClaim  @relation(fields: [claimId], references: [id], onDelete: Restrict)
  source   ProspectResearchSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([claimId, sourceId])
  @@map("prospect_research_claim_sources")
}

model ProspectEmailDraft {
  id                 String                    @id @default(uuid()) @db.Uuid
  companyId          String                    @map("company_id") @db.Uuid
  prospectId         String                    @map("prospect_id") @db.Uuid
  createdBy          String                    @map("created_by") @db.Uuid
  aiRequestLogId     String?                   @unique @map("ai_request_log_id") @db.Uuid
  recipientName      String?                   @map("recipient_name")
  recipientEmail     String?                   @map("recipient_email")
  subject            String
  body               String
  language           String                    @default("English")
  tone               String                    @default("professional")
  objective          String                    @default("introduce_shifd_labs")
  offering           String                    @default("custom_web_application")
  origin             String                    @default("manual")
  status             String                    @default("draft")
  shareToken         String?                   @unique @map("share_token")
  archivedAt         DateTime?                 @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int                       @default(1)
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  prospect           Prospect                  @relation(fields: [companyId, prospectId], references: [companyId, id], onDelete: Restrict)
  creator            User                      @relation("ProspectEmailDraftCreator", fields: [companyId, createdBy], references: [companyId, id], onDelete: Restrict)
  aiRequestLog       AiRequestLog?             @relation(fields: [companyId, aiRequestLogId], references: [companyId, id], onDelete: Restrict)
  researchClaims     ProspectEmailDraftClaim[]
  outboundActivities OutboundActivity[]
  feedback           ProspectEmailDraftFeedback[]

  @@unique([companyId, id])
  @@unique([companyId, aiRequestLogId])
  @@index([companyId, prospectId, status, updatedAt(sort: Desc)])
  @@map("prospect_email_drafts")
}

model ProspectEmailDraftFeedback {
  id        String             @id @default(uuid()) @db.Uuid
  draftId   String             @map("draft_id") @db.Uuid
  message   String
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  draft     ProspectEmailDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@index([draftId, createdAt(sort: Desc)])
  @@map("prospect_email_draft_feedback")
}

model ProspectEmailDraftClaim {
  draftId String                @map("draft_id") @db.Uuid
  claimId String                @map("claim_id") @db.Uuid
  draft   ProspectEmailDraft    @relation(fields: [draftId], references: [id], onDelete: Restrict)
  claim   ProspectResearchClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@id([draftId, claimId])
  @@index([claimId])
  @@map("prospect_email_draft_claims")
}

model OutboundActivity {
  id                  String             @id @default(uuid()) @db.Uuid
  companyId           String             @map("company_id") @db.Uuid
  prospectId          String             @map("prospect_id") @db.Uuid
  emailDraftId        String?            @map("email_draft_id") @db.Uuid
  activityType        String             @map("activity_type")
  status              String             @default("recorded")
  occurredAt          DateTime?          @map("occurred_at") @db.Timestamptz(3)
  dueAt               DateTime?          @map("due_at") @db.Timestamptz(3)
  completedAt         DateTime?          @map("completed_at") @db.Timestamptz(3)
  contactName         String?            @map("contact_name")
  contactEmail        String?            @map("contact_email")
  subject             String?
  description         String?
  responseClassification String?         @map("response_classification")
  provenance          String
  notes               String?
  createdBy           String             @map("created_by") @db.Uuid
  updatedBy           String?            @map("updated_by") @db.Uuid
  archivedBy          String?            @map("archived_by") @db.Uuid
  archivedAt          DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  prospect            Prospect           @relation(fields: [companyId, prospectId], references: [companyId, id], onDelete: Restrict)
  emailDraft          ProspectEmailDraft? @relation(fields: [companyId, emailDraftId], references: [companyId, id], onDelete: Restrict)
  creator             User               @relation("OutboundActivityCreator", fields: [companyId, createdBy], references: [companyId, id], onDelete: Restrict)
  updater             User?              @relation("OutboundActivityUpdater", fields: [companyId, updatedBy], references: [companyId, id], onDelete: Restrict)
  archiver            User?              @relation("OutboundActivityArchiver", fields: [companyId, archivedBy], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, prospectId, occurredAt(sort: Desc), createdAt(sort: Desc)])
  @@index([companyId, prospectId, status, dueAt])
  @@index([companyId, emailDraftId])
  @@map("outbound_activities")
}

model MarketingEvaluation {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  revision    Int
  startDate   DateTime @map("start_date") @db.Date
  timezone    String
  definitions Json
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator     User     @relation("EvaluationCreator", fields: [companyId, createdBy], references: [companyId, id], onDelete: Restrict)
  snapshots   EvaluationSnapshot[]

  @@unique([companyId, id])
  @@unique([companyId, revision])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("marketing_evaluations")
}

model EvaluationSnapshot {
  id           String              @id @default(uuid()) @db.Uuid
  evaluationId String              @map("evaluation_id") @db.Uuid
  stage        String
  capturedAt   DateTime            @map("captured_at") @db.Timestamptz(3)
  measurements Json
  source       String
  notes        String?
  recordedBy   String              @map("recorded_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  evaluation   MarketingEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  recorder     User                @relation("EvaluationSnapshotRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@unique([evaluationId, stage])
  @@index([evaluationId, capturedAt])
  @@map("evaluation_snapshots")
}

model BusinessInquiry {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  prospectId      String?   @map("prospect_id") @db.Uuid
  receivedAt      DateTime  @map("received_at") @db.Timestamptz(3)
  channel         String
  companyName     String?   @map("company_name")
  summary         String
  relevance       String
  source          String
  sourceReference String?   @map("source_reference")
  followUpNotes   String?   @map("follow_up_notes")
  recordedBy      String    @map("recorded_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  prospect        Prospect? @relation(fields: [companyId, prospectId], references: [companyId, id], onDelete: Restrict)
  recorder        User      @relation("InquiryRecorder", fields: [companyId, recordedBy], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, receivedAt])
  @@index([companyId, relevance, receivedAt])
  @@map("business_inquiries")
}

model ProductionTimeLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  contentId  String   @map("content_id") @db.Uuid
  minutes    Int
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  notes      String?
  recordedBy String   @map("recorded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  content    Content  @relation(fields: [companyId, contentId], references: [companyId, id], onDelete: Restrict)
  recorder   User     @relation("ProductionTimeRecorder", fields: [companyId, recordedBy], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, occurredAt])
  @@index([companyId, contentId])
  @@map("production_time_logs")
}

model BrandProfile {
  companyId               String   @id @map("company_id") @db.Uuid
  brandVoice              String?  @map("brand_voice")
  toneDescription         String?  @map("tone_description")
  preferredLanguage       String   @default("English") @map("preferred_language")
  communicationGuidelines String[] @default([]) @map("communication_guidelines")
  preferredTerms          String[] @default([]) @map("preferred_terms")
  thingsToAvoid           String[] @default([]) @map("things_to_avoid")
  ctaStyle                String?  @map("cta_style")
  brandKeywords           String[] @default([]) @map("brand_keywords")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                 Int      @default(1)
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("brand_profiles")
}

model BmcBlock {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  type      String
  entries   String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(1)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, type])
  @@index([companyId])
  @@map("bmc_blocks")
}

model Product {
  id                     String                   @id @default(uuid()) @db.Uuid
  companyId              String                   @map("company_id") @db.Uuid
  name                   String
  slug                   String
  description            String
  category               String?
  status                 String
  url                    String?
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                Int                      @default(1)
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  profile                ProductProfile?
  contentIdeas           ContentIdea[]
  contents               Content[]
  topicDiscoveryRuns     TopicDiscoveryRun[]
  topicCandidates        TopicCandidate[]
  telegramIntegrations   TelegramIntegration[]
  telegramThreads        TelegramIdeationThread[]
  telegramIdeaDrafts     TelegramIdeaDraft[]
  telegramCallbackTokens TelegramCallbackToken[]

  @@unique([companyId, slug])
  @@unique([companyId, id])
  @@index([companyId, status])
  @@map("products")
}

model ProductProfile {
  productId           String   @id @map("product_id") @db.Uuid
  targetUsers         String[] @default([]) @map("target_users")
  targetOrganizations String[] @default([]) @map("target_organizations")
  decisionMakers      String[] @default([]) @map("decision_makers")
  problemsAddressed   String[] @default([]) @map("problems_addressed")
  valueProposition    String?  @map("value_proposition")
  features            String[] @default([])
  benefits            String[] @default([])
  differentiators     String[] @default([])
  useCases            String[] @default([]) @map("use_cases")
  campaignObjective   String?  @map("campaign_objective")
  positioning         String?
  keyMessages         String[] @default([]) @map("key_messages")
  proofPoints         String[] @default([]) @map("proof_points")
  defaultCta          String?  @map("default_cta")
  inheritCompanyTone  Boolean  @default(true) @map("inherit_company_tone")
  toneOverride        String?  @map("tone_override")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version             Int      @default(1)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("product_profiles")
}

model ContentPillar {
  code               String              @id
  label              String
  sortOrder          Int                 @unique @map("sort_order")
  active             Boolean             @default(true)
  contentIdeas       ContentIdea[]
  contentBriefs      ContentBrief[]
  telegramIdeaDrafts TelegramIdeaDraft[]

  @@unique([label])
  @@map("content_pillars")
}

model ContentIdea {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  title           String
  contextType     String              @map("context_type")
  productId       String?             @map("product_id") @db.Uuid
  pillarCode      String              @map("pillar_code")
  objective       String
