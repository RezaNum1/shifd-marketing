  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product        Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  aiRequestLog   AiRequestLog     @relation(fields: [aiRequestLogId], references: [id], onDelete: Restrict)
  candidates     TopicCandidate[]

  @@index([companyId, createdAt, id])
  @@index([companyId, status, createdAt])
  @@map("topic_discovery_runs")
}

model TopicCandidate {
  id                 String            @id @default(uuid()) @db.Uuid
  runId              String            @map("run_id") @db.Uuid
  companyId          String            @map("company_id") @db.Uuid
  productId          String?           @map("product_id") @db.Uuid
  position           Int
  title              String
  summary            String
  whyCurrent         String            @map("why_current")
  relevanceToCompany String            @map("relevance_to_company")
  contentAngle       String            @map("content_angle")
  suggestedObjective String            @map("suggested_objective")
  suggestedPlatforms String[]          @map("suggested_platforms")
  sourceEvidence     Json              @map("source_evidence")
  selectedAt         DateTime?         @map("selected_at") @db.Timestamptz(3)
  createdIdeaId      String?           @unique @map("created_idea_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  run                TopicDiscoveryRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product            Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdIdea        ContentIdea?      @relation(fields: [createdIdeaId], references: [id], onDelete: Restrict)

  @@unique([runId, position])
  @@index([companyId, createdAt, id])
  @@index([runId, position])
  @@map("topic_candidates")
}

model AiSettings {
  companyId          String   @id @map("company_id") @db.Uuid
  provider           String
  modelId            String?  @map("model_id")
  modelDisplayName   String   @map("model_display_name")
  generationLanguage String   @default("English") @map("generation_language")
  mode               String   @default("real")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int      @default(1)
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("ai_settings")
}

model PromptVersion {
  id                  String         @id @default(uuid()) @db.Uuid
  module              String
  operation           String
  version             String
  status              String
  templateReference   String         @map("template_reference")
  templateDigest      String         @map("template_digest")
  outputSchemaVersion String         @map("output_schema_version")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  aiRequests          AiRequestLog[]
  prospectResearchRuns ProspectResearchRun[]

  @@unique([module, version])
  @@index([module, status])
  @@map("prompt_versions")
}

model AiRequestLog {
  id                              String                    @id @default(uuid()) @db.Uuid
  companyId                       String                    @map("company_id") @db.Uuid
  contentId                       String?                   @map("content_id") @db.Uuid
  variantId                       String?                   @map("variant_id") @db.Uuid
  requestedBy                     String                    @map("requested_by") @db.Uuid
  promptVersionId                 String                    @map("prompt_version_id") @db.Uuid
  module                          String
  operation                       String
  provider                        String
  model                           String
  mode                            String
  language                        String
  editorialRevision               Int?                      @map("editorial_revision")
  variantRevision                 Int?                      @map("variant_revision")
  inputHash                       String                    @map("input_hash")
  inputSnapshot                   Json                      @map("input_snapshot")
  inputTokens                     BigInt?                   @map("input_tokens")
  cachedInputTokens               BigInt?                   @map("cached_input_tokens")
  outputTokens                    BigInt?                   @map("output_tokens")
  estimatedCostUsd                Decimal?                  @map("estimated_cost_usd") @db.Decimal(18, 8)
  costBasis                       Json?                     @map("cost_basis")
  latencyMs                       Int?                      @map("latency_ms")
  status                          String
  errorCode                       String?                   @map("error_code")
  errorMessage                    String?                   @map("error_message")
  providerRequestId               String?                   @map("provider_request_id")
  createdAt                       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt                     DateTime?                 @map("completed_at") @db.Timestamptz(3)
  company                         Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  content                         Content?                  @relation(fields: [contentId], references: [id], onDelete: Restrict)
  variant                         PlatformVariant?          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  requester                       User                      @relation(fields: [requestedBy], references: [id], onDelete: Restrict)
  promptVersion                   PromptVersion             @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  idempotency                     RequestIdempotency?       @relation("RequestIdempotencyAiRequest")
  brandAssessment                 BrandAssessment?
  creativeReferenceConceptBatches CreativeReferenceBatch[]  @relation("CreativeReferenceConceptPlanner")
  creativeReferenceImages         CreativeReference[]       @relation("CreativeReferenceImage")
  topicDiscoveryRuns              TopicDiscoveryRun[]
  telegramMessages                TelegramIdeationMessage[]
  prospectResearchRun             ProspectResearchRun?
  prospectEmailDraft              ProspectEmailDraft?

  @@unique([companyId, id])
  @@index([companyId, createdAt, id])
  @@index([contentId, createdAt])
  @@index([status])
  @@map("ai_request_logs")
}

model CreativeReferenceBatch {
  id                           String              @id @default(uuid()) @db.Uuid
  contentId                    String              @map("content_id") @db.Uuid
  companyId                    String              @map("company_id") @db.Uuid
  platform                     String
  style                        String
  mood                         String
  requestedAspectRatio         String              @map("requested_aspect_ratio")
  actualGeneratedSize          String              @map("actual_generated_size")
  creativeFormat               String              @default("single_image") @map("creative_format")
  generationMode               String              @default("original_design") @map("generation_mode")
  expectedReferenceCount       Int                 @default(3) @map("expected_reference_count")
  additionalInstruction        String?             @map("additional_instruction")
  status                       String
  conceptPlannerAiRequestLogId String?             @map("concept_planner_ai_request_log_id") @db.Uuid
  createdAt                    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt                  DateTime?           @map("completed_at") @db.Timestamptz(3)
  content                      Content             @relation(fields: [contentId], references: [id], onDelete: Restrict)
