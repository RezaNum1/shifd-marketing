model CreativeReference {
  id                  String                 @id @default(uuid()) @db.Uuid
  batchId             String                 @map("batch_id") @db.Uuid
  conceptIndex        Int                    @map("concept_index")
  conceptName         String                 @map("concept_name")
  templateType        String?                @map("template_type")
  slideNumber         Int?                   @map("slide_number")
  slideCopy           String?                @map("slide_copy")
  rationale           String
  layoutNotes         String                 @map("layout_notes")
  visualFocus         String                 @map("visual_focus")
  typographyDirection String                 @map("typography_direction")
  canvaBrief          String?                @map("canva_brief")
  assetSearchKeywords String[]               @default([]) @map("asset_search_keywords")
  carouselOutline     String[]               @default([]) @map("carousel_outline")
  imagePrompt         String                 @map("image_prompt")
