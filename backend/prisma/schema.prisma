model SocialAccount {
  id                   String                 @id @default(uuid()) @db.Uuid
  companyId            String                 @map("company_id") @db.Uuid
  platform             String
  accountName          String?                @map("account_name")
  externalAccountId    String?                @map("external_account_id")
  mode                 String
  connectionStatus     String                 @map("connection_status")
  reportingTimezone    String                 @map("reporting_timezone")
  lastSuccessfulSyncAt DateTime?              @map("last_successful_sync_at") @db.Timestamptz(3)
  credentialReference  String?                @map("credential_reference")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  version              Int                    @default(1)
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  weeklyMetrics        WeeklyMetric[]
  inquiryMetrics       InboundInquiryMetric[]
  publicationMetrics   PublicationMetric[]

  @@unique([companyId, platform])
  @@index([companyId, platform])
  @@map("social_accounts")
}

model WeeklyMetric {
  id                     String         @id @default(uuid()) @db.Uuid
  socialAccountId        String         @map("social_account_id") @db.Uuid
  weekStart              DateTime       @map("week_start") @db.Date
  weekEnd                DateTime       @map("week_end") @db.Date
  followers              BigInt
  reach                  BigInt?
  impressions            BigInt?
  likes                  BigInt?
  comments               BigInt?
  saves                  BigInt?
  reportedPublishedPosts Int            @map("reported_published_posts")
  nativeEngagementRate   Float?          @map("native_engagement_rate")
  source                 String
  evidenceAssetId        String?        @map("evidence_asset_id") @db.Uuid
  notes                  String?
  recordedBy             String?        @map("recorded_by") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                Int            @default(1)
  socialAccount          SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  evidenceAsset          CreativeAsset? @relation(fields: [evidenceAssetId], references: [id], onDelete: Restrict)
  recorder               User?          @relation("MetricRecordedBy", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@unique([socialAccountId, weekStart, weekEnd])
  @@index([socialAccountId, weekStart])
  @@index([evidenceAssetId])
  @@map("weekly_metrics")
}

model InboundInquiryMetric {
  id              String        @id @default(uuid()) @db.Uuid
  socialAccountId String        @map("social_account_id") @db.Uuid
  weekStart       DateTime      @map("week_start") @db.Date
  weekEnd         DateTime      @map("week_end") @db.Date
  count           Int
  source          String
  recordedBy      String?       @map("recorded_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int           @default(1)
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  recorder        User?         @relation("InquiryRecordedBy", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@unique([socialAccountId, weekStart, weekEnd])
  @@index([socialAccountId, weekStart])
  @@map("inbound_inquiry_metrics")
}

model ApprovalAction {
  id                String            @id @default(uuid()) @db.Uuid
  contentId         String            @map("content_id") @db.Uuid
  variantId         String?           @map("variant_id") @db.Uuid
  assessmentId      String?           @map("assessment_id") @db.Uuid
  editorialRevision Int               @map("editorial_revision")
  action            String
  actorId           String            @map("actor_id") @db.Uuid
  justification     String?
  checklist         Json?
  reviewedVariants  Json?             @map("reviewed_variants")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  content           Content           @relation("ContentApprovalActions", fields: [contentId], references: [id], onDelete: Restrict)
  currentForContent Content[]         @relation("ContentCurrentApproval")
  schedules         ContentSchedule[]
  variant           PlatformVariant?  @relation(fields: [contentId, variantId], references: [contentId, id], onDelete: Restrict)
  assessment        BrandAssessment?  @relation(fields: [variantId, assessmentId], references: [variantId, id], onDelete: Restrict)
  actor             User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([contentId, id])
  @@index([contentId, createdAt, id])
  @@index([variantId])
  @@index([assessmentId])
  @@map("approval_actions")
}
